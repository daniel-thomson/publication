     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Practitioner practitioner-death-date</b></p><a name=\"practitioner-death-date\"> </a><a name=\"hcpractitioner-death-date\"> </a><a name=\"practitioner-death-date-en-US\"> </a><p><b>name</b>: Marcus Welby</p><p><b>gender</b>: Male</p><p><b>birthDate</b>: 1998-01-01</p></div>"
  ] ; # 
  fhir:extension ( [
