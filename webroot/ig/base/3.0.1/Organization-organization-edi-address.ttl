     fhir:name [
       fhir:text [ fhir:v "HealthLink EDI account" ]
     ] ;
     fhir:telecom ( [
       fhir:system [
         fhir:v "other" ;
         fhir:extension ( [
           fhir:url [ fhir:v "http://hl7.org.nz/fhir/StructureDefinition/edi-address"^^xsd:anyURI ] ;
           fhir:value [ fhir:v "ABC-876" ]
         ] )
       ]
     ] )
  ] ) . # 

