@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.org.nz/ig/base/Coverage/CoverageGMS> a fhir:Coverage ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "CoverageGMS"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://hl7.org.nz/fhir/StructureDefinition/NzCoverage"^^xsd:anyURI ;
       fhir:link <http://hl7.org.nz/fhir/StructureDefinition/NzCoverage>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "additional" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\">GMS Entitlement for Raewyn Joseph<br/>NHI ZZZ0032<br/></div>"
  ] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:type [
     fhir:coding ( [
       fhir:system [ fhir:v "https://standards.digital.health.nz/ns/coverage-type-code"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "gms" ] ;
       fhir:display [ fhir:v "General Medical Subsidy" ]
     ] )
  ] ; # 
  fhir:subscriber [
     fhir:link <http://fhir.org.nz/ig/base/Patient/patient-dhb> ;
     fhir:reference [ fhir:v "Patient/patient-dhb" ]
  ] ; # 
  fhir:beneficiary [
     fhir:link <http://fhir.org.nz/ig/base/Patient/patient-dhb> ;
     fhir:reference [ fhir:v "Patient/patient-dhb" ]
  ] ; # 
  fhir:relationship [
     fhir:coding ( [
       fhir:system [ fhir:v "http://terminology.hl7.org/CodeSystem/subscriber-relationship"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "self" ]
     ] )
  ] ; # 
  fhir:payor ( [
     fhir:link <http://fhir.org.nz/ig/base/Organization/organization-moh> ;
     fhir:reference [ fhir:v "Organization/organization-moh" ]
  ] ) ; # 
  fhir:class ( [
     fhir:type [
       fhir:coding ( [
         fhir:system [ fhir:v "https://standards.digital.health.nz/ns/coverage-category-code"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "under6" ] ;
         fhir:display [ fhir:v "A child under 6 years of age" ]
       ] )
     ] ;
     fhir:value [ fhir:v "Baby" ]
  ] ) . # 

