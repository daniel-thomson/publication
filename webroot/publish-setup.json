{
  "website": {
    "style": "fhir.layout",
    "url": "http://fhir.org.nz",
    "server": "apache",
    "org": "HL7 New Zealand",
    "search-template": "searchform.template.html",
    "index-template": "index.template",
    "clone-xml-json": false
  },
  "feeds": {
    "package": "package-feed.xml",
    "publication": "publication-feed.xml"
  },
  "layout-rules": [
    {
      "npm": "fhir.org.nz.ig.*",
      "url": "http://fhir.org.nz/ig/{5}",
      "canonical": "http://fhir.org.nz/ig/{5}",
      "destination": "/ig/{5}"
    }
  ]
}
